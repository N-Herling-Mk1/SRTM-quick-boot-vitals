# srtm-quickboot-vitals -- copy to .env and fill in. NEVER commit .env.
#
# On bigmem3 the values can be lifted from Prof. Cheu's stack:
#     set -a; . ~/srtm-TIG/.env; set +a
# ...but generate your own read-scoped token in InfluxDB if you can.
# The token in his repo is admin-scoped and world-readable on GitHub.

INFLUX_URL=http://127.0.0.1:8096
INFLUXDB_ORG=SRTM
INFLUXDB_BUCKET=SRTM-bucket
INFLUXDB_TOKEN=

SRTM_MEASUREMENT=srtm
VITALS_WINDOW_MIN=30
VITALS_MIN_SAMPLES=20
VITALS_POLL_SEC=5
